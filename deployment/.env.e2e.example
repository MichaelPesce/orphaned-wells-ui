# Docker Compose project naming for the isolated E2E stack.
COMPOSE_PROJECT_NAME=orphaned-wells-e2e

# Backend runtime mode.
# auto uses sibling backend source when it exists, otherwise it pulls BACKEND_IMAGE.
# image always pulls BACKEND_IMAGE.
# source requires BACKEND_DIR to contain backend source and builds the backend locally.
BACKEND_MODE=auto
BACKEND_IMAGE=michaelpescelbl/orphaned-wells-ui-server:latest
BACKEND_DEV_IMAGE=orphaned-wells-ui-server-e2e-dev

# Optional sibling backend source. This path is relative to orphaned-wells-ui/deployment.
BACKEND_DIR=../../orphaned-wells-ui-server
BACKEND_GIT_URL=https://github.com/CATALOG-Historic-Records/orphaned-wells-ui-server.git
BACKEND_AUTO_CLONE=false

# E2E ports intentionally differ from the normal development stack.
DEV_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8002
MONGODB_HOST_PORT=27019

# Container hostnames used for service-local bind addresses.
FRONTEND_CONTAINER_HOST=frontend
BACKEND_CONTAINER_HOST=backend
MONGODB_CONTAINER_HOST=mongodb

# Frontend runtime variables.
REACT_APP_BACKEND_URL=http://localhost:8002
REACT_APP_COLLABORATOR=isgs
REACT_APP_CLIENT_ID=
REACT_APP_GOOGLE_CLIENTID=
GOOGLE_REFRESH_TOKEN=

# Backend app variables.
ENVIRONMENT=development
COLLABORATOR=isgs
LOCATION=us
DB_CONNECTION=mongodb://mongodb:27017
DB_NAME=isgs_e2e
DB_USERNAME=
DB_PASSWORD=
REQUIRE_AUTH=false
USE_DB_PROCESSORS=true
STORAGE_BACKEND=local
LOCAL_STORAGE_URL_BASE=http://localhost:8002/local-storage
DOCUMENT_AI_BACKEND=google
DOCUMENT_AI_URL=
DOCUMENT_AI_TIMEOUT=60

# Mongo dump initialization.
# Runs automatically only when the MongoDB volume is first created.
MONGO_INIT_SAMPLE_DUMP=true
MONGO_DUMP_SOURCE_DB=isgs

# Optional Google Cloud / OAuth settings. Leave blank for local auth-disabled E2E.
# With STORAGE_BACKEND=google, put STORAGE_SERVICE_KEY next to this file or use an absolute path.
PROJECT_ID=
STORAGE_SERVICE_KEY=
STORAGE_BUCKET_NAME=
token_uri=
client_id=
client_secret=
APIKEY=
AUTH_PROVIDER=google
ALLOWED_ORIGINS=http://localhost:3001
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=3600
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# Optional backend diagnostics.
MEMORY_PROFILE=false
PROCESS_IMAGE_IN_SUBPROCESS=false
